"""run_case - build a wujian100_open case and run it on QuestaSim.

QuestaSim-only flow, replacement for the original perl script (vcs) and the
iverilog/vcs branches of the earlier python port:

    step1  clean workdir
    step2  copy the case sources into workdir
    step3  build the firmware (riscv gcc -> elf -> srec -> test.pat)
    step4  vlib / vlog / vsim

The firmware is built by calling the riscv toolchain directly instead of
going through make, so the flow needs nothing but python, the toolchain and
QuestaSim - no make, no POSIX shell.

usage:
    run_case [-pat <test.pat>] [-toolchain <dir>] [-tmax 10ms]
             [-gui] [-nodump] [-nomnt] <case.c>
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

# ---------------------------------------------------------------- constants
ROOT = Path(__file__).resolve().parent.parent
WORKDIR = ROOT / "workdir"
REGRESS = ROOT / "regress" / "regress_result"

# e902m = machine mode core, the only core these cases are built for
CPU_MODEL = "e902"
CPU_MAKE = "e902m"
DATA_ADDR = "0x20000000"

TOP = "wujian100_open_tb"
SOC_LIST = ["../soc/wujian100_open_lib_for_iverilog.filelist",
            "../soc/wujian100_open_syn_for_iverilog.filelist"]
TB_SRC = ["../tb/tb.v", "../tb/busmnt.v", "../tb/virtual_counter.v"]

# where the riscv toolchain usually lives, in order of preference:
#   -toolchain <path>  ->  $TOOL_PATH  ->  these defaults
DEFAULT_TOOLCHAIN = [
    Path("D:/workbuddy/work/riscv-toolchain"),
    ROOT.parent / "riscv-toolchain",
    Path("/opt/riscv"),
]

# where QuestaSim usually lives: $QUESTA_HOME  ->  these defaults
DEFAULT_QUESTA = [
    Path("D:/questasim64_10.6c"),
    Path("C:/questasim64_10.6c"),
    Path("D:/questasim"),
    Path("C:/questasim"),
    Path("/opt/questa"),
    Path("/opt/modelsim"),
]

# child processes get this environment (PATH + the questasim bin dir)
ENV = None

# cases that need an extra verilog stimulus file next to the source
STIM_KEY_S = ("had", "gpio", "connect", "pulse", "lpmd", "int_ack", "bist")


# ------------------------------------------------------------------- helper
def log(msg=""):
    print(msg, flush=True)


def die(msg, code=1):
    print("\n[run_case] ERROR: " + msg, file=sys.stderr, flush=True)
    sys.exit(code)


def sh(cmd, cwd=None, check=True):
    """run a command, echo it, abort on failure unless check=False"""
    log("+ " + " ".join(str(c) for c in cmd))
    rc = subprocess.run([str(c) for c in cmd], cwd=cwd, env=ENV).returncode
    if check and rc != 0:
        die("command failed (rc=%d): %s" % (rc, " ".join(str(c) for c in cmd)))
    return rc


def _vsim_in(directory):
    """return the vsim executable inside directory, or None"""
    for name in ("vsim.exe", "vsim", "vsim.bat"):
        cand = directory / name
        if cand.is_file():
            return cand
    return None


def find_questa():
    """locate the QuestaSim bin directory (win64 / win32 / bin)"""
    cands = []
    if os.environ.get("QUESTA_HOME"):
        cands.append(norm_path(os.environ["QUESTA_HOME"]))
    cands += DEFAULT_QUESTA
    for root in cands:
        for sub in ("win64", "win32", "bin", ""):
            d = root / sub if sub else root
            if d.is_dir() and _vsim_in(d):
                return d
    # maybe it is already on PATH
    found = shutil.which("vsim")
    return Path(found).parent if found else None


def prepare_env():
    """put the questasim bin directory on PATH.

    vlog / vsim / vlib are looked up by name, and on windows the executable
    search uses the PATH of *this* process - passing env= to subprocess is not
    enough (CreateProcess does not search the child environment).  So PATH is
    modified in place, and the resulting environment is handed to every child.

    This is what makes `source setup.sh` unnecessary: run_case works from
    cmd.exe and PowerShell too, as long as QuestaSim sits in a default place.
    """
    global ENV
    qbin = find_questa()
    if qbin is not None:
        path = os.environ.get("PATH", "")
        if str(qbin).lower() not in path.lower():
            os.environ["PATH"] = str(qbin) + os.pathsep + path
        os.environ["QUESTA_HOME"] = str(qbin.parent)
    ENV = os.environ.copy()
    return qbin


def tool_exists(name):
    return shutil.which(name, path=ENV["PATH"] if ENV else None) is not None


def norm_path(p):
    """accept msys / git-bash / wsl style paths on windows.

        /d/foo       -> D:/foo
        /mnt/d/foo   -> D:/foo     (wsl path, handy when the same command
                                    line is used from both shells)
    """
    s = str(p)
    if os.name == "nt" and s.startswith("/"):
        if len(s) > 6 and s[1:5].lower() == "mnt/" and s[5].isalpha() and s[6] == "/":
            s = s[5].upper() + ":" + s[6:]
        elif len(s) > 2 and s[1].isalpha() and s[2] == "/":
            s = s[1].upper() + ":" + s[2:]
    return Path(s)


def find_toolchain(explicit):
    """locate riscv64-unknown-elf-gcc, return (root, gcc)"""
    cands = []
    if explicit:
        cands.append(norm_path(explicit))
    if os.environ.get("TOOL_PATH"):
        cands.append(norm_path(os.environ["TOOL_PATH"]))
    cands += DEFAULT_TOOLCHAIN
    for root in cands:
        for name in ("riscv64-unknown-elf-gcc.exe", "riscv64-unknown-elf-gcc"):
            gcc = root / "bin" / name
            if gcc.is_file():
                return root, gcc
    return None, None


def tool_of(root, name):
    """resolve <root>/bin/<name>[.exe]"""
    for cand in (root / "bin" / (name + ".exe"), root / "bin" / name):
        if cand.is_file():
            return cand
    die("missing tool: %s under %s/bin" % (name, root))


def probe_toolchain(gcc):
    """return (ok, first line of --version)"""
    try:
        res = subprocess.run([str(gcc), "--version"], capture_output=True,
                             text=True, timeout=30, env=ENV)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    out = (res.stdout or "") + (res.stderr or "")
    if res.returncode != 0:
        first = out.strip().splitlines()[0] if out.strip() else "exit %d" % res.returncode
        return False, first
    return True, out.splitlines()[0] if out.strip() else "ok"


# --------------------------------------------------------------- case copy
def clean_workdir():
    if WORKDIR.name != "workdir" or WORKDIR.parent != ROOT:
        die("refuse to clean %s" % WORKDIR)
    for entry in WORKDIR.iterdir():
        if entry.name in ("README", "CVS", ".gitignore"):
            continue
        if entry.is_dir():
            shutil.rmtree(entry, ignore_errors=True)
        else:
            try:
                entry.unlink()
            except OSError:
                pass
    log("\nStep1 (Remove all things in current 'workdir') is finished!")


def copy_file(src, dst_dir):
    dst = Path(dst_dir) / Path(src).name
    try:
        shutil.copy2(src, dst)
    except OSError as exc:
        die("can't copy %s (%s)" % (src, exc))
    return dst


def copy_case(case_path):
    """copy the case sources into workdir, return (case name, stim list)"""
    if not case_path.is_file():
        die("case file not found: %s" % case_path)
    name = case_path.name
    stem = case_path.stem
    suffix = case_path.suffix.lower()
    stims = []

    if suffix == ".s":
        copy_file(case_path, WORKDIR)
        low = name.lower()
        if any(k in low for k in STIM_KEY_S) or "nest" in low:
            v_file = case_path.with_suffix(".v")
            if v_file.is_file():
                copy_file(v_file, WORKDIR)
                stims.append("../workdir/" + v_file.name)
    elif suffix == ".c":
        for entry in sorted(case_path.parent.iterdir()):
            if entry.name == "CVS" or not entry.is_file():
                continue
            copy_file(entry, WORKDIR)
            if entry.suffix.lower() == ".v":
                stims.append("../workdir/" + entry.name)
        # minimal c library needed by the case
        for pattern in ("*.h", "*.c"):
            for src in sorted((ROOT / "lib" / "clib").glob(pattern)):
                copy_file(src, WORKDIR)
        for src in sorted((ROOT / "lib" / "newlib_wrap").glob("*.c")):
            copy_file(src, WORKDIR)
    else:
        die("unsupported case type: %s (expect .c or .s)" % name)

    log("\nStep2 (Process the command line arguments) is finished!")
    return stem, stims


def prepare_build():
    """copy the makefile / linker script / crt0 into workdir"""
    for src in ("Makefile", "crt0.s", "linker.lcf"):
        copy_file(ROOT / "lib" / src, WORKDIR)
    linker = WORKDIR / "linker.lcf"
    linker.write_text(linker.read_text(errors="replace").replace(
        "DATA_BADDR", DATA_ADDR), errors="replace")


# -------------------------------------------------------------- firmware
def build_firmware(case_name, pat_file, toolchain):
    if pat_file is not None:
        dst = WORKDIR / "test.pat"
        try:
            shutil.copy2(pat_file, dst)
        except OSError as exc:
            die("can't copy %s (%s)" % (pat_file, exc))
        log("\nStep3 (Skip firmware build, use prebuilt %s) is finished!" % dst)
        return

    root, gcc = find_toolchain(toolchain)
    if gcc is None:
        die("riscv64-unknown-elf-gcc not found, pass -toolchain <dir> or set TOOL_PATH")
    ok, desc = probe_toolchain(gcc)
    if not ok:
        die("can't execute %s\n  -> %s\n"
            "  This looks like a linux ELF being run on windows; use the\n"
            "  T-HEAD win32/win64 build of the toolchain." % (gcc, desc))
    log("toolchain : %s" % desc)
    log("toolchain : %s" % root)

    march, mabi = ("rv32emc", "ilp32e") if "e902m" in CPU_MAKE else ("rv32ec", "ilp32e")
    cflags = ["-march=" + march, "-mabi=" + mabi,
              "-D" + CPU_MODEL, "-Wa,--defsym=%s=1" % CPU_MODEL,
              "-O3", "-funroll-all-loops", "-fgcse-sm", "-finline-limit=500",
              "-fno-schedule-insns", "-ffunction-sections", "-fdata-sections"]

    for stale in list(WORKDIR.glob("*.pat")) + list(WORKDIR.glob("*.elf")) \
            + list(WORKDIR.glob("*.o")) + list(WORKDIR.glob("*.hex")) \
            + list(WORKDIR.glob("*.obj")):
        stale.unlink()

    # NB: windows filesystems are case insensitive, so "*.S" also matches
    # "crt0.s" - dedup by lower-cased name to avoid compiling it twice
    seen = {}
    for pattern in ("*.S", "*.s", "*.c"):
        for src in sorted(WORKDIR.glob(pattern)):
            seen.setdefault(src.name.lower(), src)
    sources = [seen[k] for k in sorted(seen)]
    if not sources:
        die("no source files found in %s" % WORKDIR)

    objects = []
    for src in sources:
        sh([gcc, "-c"] + cflags + ["-o", src.stem + ".o", src.name], cwd=WORKDIR)
        objects.append(src.stem + ".o")
    # crt0 first: the linker script expands crt0.o(.text) at 0x0
    objects.sort(key=lambda n: (not n.startswith("crt0"), n))

    elf = case_name + ".elf"
    sh([gcc, "-Tlinker.lcf", "-nostartfiles", "-march=" + march,
        "-mabi=" + mabi, "-lc", "-lgcc"] + objects + ["-o", elf, "-lm"],
       cwd=WORKDIR)

    # keep the large disassembly listing out of the console
    with open(WORKDIR / (case_name + ".obj"), "w") as fh:
        log("+ objdump -S -Mnumeric %s > %s.obj" % (elf, case_name))
        res = subprocess.run([str(tool_of(root, "riscv64-unknown-elf-objdump")),
                              "-S", "-Mnumeric", elf],
                             cwd=WORKDIR, stdout=fh, stderr=subprocess.PIPE,
                             text=True, env=ENV)
    if res.returncode != 0:
        die("objdump failed: %s" % (res.stderr or "").strip())

    sh([tool_of(root, "riscv64-unknown-elf-objcopy"),
        "-O", "srec", elf, case_name + ".hex"], cwd=WORKDIR)
    sh([sys.executable, str(ROOT / "tools" / "Srec2vmem.py"),
        "-i", case_name + ".hex", "-o", "test.pat"], cwd=WORKDIR)

    if not (WORKDIR / "test.pat").is_file():
        die("build finished but test.pat was not generated")
    log("\nStep3 (Build firmware) is finished!")


# ---------------------------------------------------------------- questasim
def stim_top_modules(stims):
    """module names declared inside the case stimulus files.

    A case such as gpio ships gpio_test.v, a stand-alone module that forces
    the pads.  QuestaSim only elaborates the tops named on the command line,
    so those modules have to be passed to vsim explicitly.
    """
    names = []
    for rel in stims:
        path = WORKDIR / Path(rel).name
        if not path.is_file():
            continue
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        for match in re.finditer(r"(?m)^\s*module\s+([A-Za-z_]\w*)", text):
            if match.group(1) not in names:
                names.append(match.group(1))
    return names


def run_questa(opts):
    # drop the previous library through QuestaSim instead of deleting the
    # directory, vdel is the only reliable way to clear a compiled library
    if (WORKDIR / "work").is_dir():
        sh(["vdel", "-all"], cwd=WORKDIR, check=False)
    sh(["vlib", "work"], cwd=WORKDIR)

    vlog = ["vlog", "-work", "work", "-timescale", "1ns/100ps", "-quiet",
            "+define+QUESTA"]
    if opts.nodump:
        vlog.append("+define+NO_DUMP")
    if opts.nomnt:
        vlog.append("+define+NO_MONITOR")
    vlog += ["+incdir+../workdir", "+incdir+../soc/params", "+incdir+../tb"]
    # -mfcu keeps the whole design in one compilation unit so the macros
    # defined in tb.v (`TB_MODULE and friends) are visible to the stimulus
    # modules shipped with a case
    vlog.append("-mfcu")
    for lst in SOC_LIST:
        vlog += ["-f", lst]
    vlog += TB_SRC + opts.stims
    sh(vlog, cwd=WORKDIR)

    tops = [TOP] + stim_top_modules(opts.stims)

    if opts.gui:
        do_lines = ["add wave -r /*", "run -all"]
    else:
        # a case waiting for a stimulus that never arrives would hang forever,
        # so cap the run time and leave the report as NOT RUN
        do_lines = ["run %s" % opts.tmax, "quit -f"]
    (WORKDIR / "run_all.do").write_text("\n".join(do_lines) + "\n")

    cmd = ["vsim"]
    cmd += ["-gui"] if opts.gui else ["-c", "-quiet"]
    cmd += ["-voptargs=+acc", "-do", "run_all.do"] + tops
    sh(cmd, cwd=WORKDIR)


# ------------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(
        prog="run_case",
        description="build a wujian100_open case and run it on QuestaSim",
        usage="run_case [options] case_file")
    ap.add_argument("case", nargs="?", help="case source (.c or .s)")
    ap.add_argument("-pat", "--pat", default=None,
                    help="use a prebuilt test.pat and skip the firmware build")
    ap.add_argument("-toolchain", "--toolchain", default=None,
                    help="riscv toolchain root, default: $TOOL_PATH or "
                         "D:/workbuddy/work/riscv-toolchain")
    ap.add_argument("-tmax", "--tmax", default="10ms",
                    help="simulation time limit, default 10ms - stops a case "
                         "that waits for a stimulus forever")
    ap.add_argument("-nodump", "--nodump", action="store_true",
                    help="disable the waveform dump")
    ap.add_argument("-nomnt", "--nomnt", action="store_true",
                    help="disable the monitor module of the testbench")
    ap.add_argument("-gui", "--gui", action="store_true",
                    help="open the GUI and dump all waves")
    opts = ap.parse_args()
    opts.stims = []

    caller_cwd = Path(os.getcwd())
    if opts.case is None and opts.pat is None:
        ap.print_usage()
        die("no case file given")

    pat_file = None
    if opts.pat:
        pat_file = norm_path(opts.pat)
        if not pat_file.is_absolute():
            pat_file = (caller_cwd / pat_file).resolve()

    qbin = prepare_env()
    log("questasim : %s" % (qbin or "<not found, pass it through PATH>"))

    t0 = time.time()
    clean_workdir()

    if opts.case:
        case_path = norm_path(opts.case)
        if not case_path.is_absolute():
            case_path = (caller_cwd / case_path).resolve()
        case_name, opts.stims = copy_case(case_path)
    else:
        case_name = pat_file.stem

    prepare_build()

    REGRESS.mkdir(parents=True, exist_ok=True)
    report = WORKDIR / "run_case.report"
    report.write_text("NOT RUN")

    build_firmware(case_name, pat_file, opts.toolchain)

    if qbin is None:
        die("vsim not found - QuestaSim is not in a default location and not "
            "on PATH; set QUESTA_HOME or add its win64 directory to PATH")

    log("\nStep4 (Run simulation with QuestaSim) ...")
    run_questa(opts)
    log("Step4 (Run simulation) is finished!")

    shutil.copy2(report, REGRESS / (case_name + ".report"))
    result = report.read_text(errors="replace").strip()
    log("\n==================== summary ====================")
    log("  simulator : QuestaSim")
    log("  case      : %s" % case_name)
    log("  result    : %s" % (result if result else "NOT RUN"))
    log("  report    : %s" % (REGRESS / (case_name + ".report")))
    log("  elapsed   : %.1f s" % (time.time() - t0))
    log("=================================================")
    return 0 if result == "TEST PASS" else 1


if __name__ == "__main__":
    sys.exit(main())
